#!/bin/bash
# ponytail: powermetrics needs root; relies on NOPASSWD sudoers entry below
t=$(sudo -n powermetrics --samplers smc -n 1 -i 1 2>/dev/null | awk -F': ' '/CPU die temperature:/{print $2; exit}')
[ -n "$t" ] && printf '#[fg=#292e42,bg=#1a1b26]#[bg=#292e42] #[fg=#9ece6a]󰽃 %s #[fg=#292e42,bg=#1a1b26] ' "$t"
