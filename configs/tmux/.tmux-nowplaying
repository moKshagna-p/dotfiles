#!/bin/bash
res=$(osascript -e '
tell application "Spotify"
  if running then
    try
      if player state is playing then
        return "♫ " & artist of current track & " - " & name of current track
      end if
    end try
  end if
end tell
' 2>/dev/null)
if [ -n "$res" ]; then
  printf '#[fg=#bb9af7]%s ' "$res"
  exit 0
fi
res=$(osascript -e '
tell application "Music"
  if running then
    try
      if player state is playing then
        return "♫ " & artist of current track & " - " & name of current track
      end if
    end try
  end if
end tell
' 2>/dev/null)
[ -n "$res" ] && printf '#[fg=#bb9af7]%s ' "$res"
